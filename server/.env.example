# Salin file ini menjadi .env lalu isi nilainya.

# Akun petugas (seed otomatis saat database kosong)
PETUGAS_USERNAME=petugas
PETUGAS_PASSWORD=ganti-dengan-password-kuat

# Akun admin (seed otomatis bila belum ada admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Secret untuk menandatangani JWT
JWT_SECRET=ganti-dengan-random-string-panjang

# Origin frontend yang diizinkan (CORS)
CORS_ORIGIN=http://localhost:5173

# Turso (libSQL) — isi setelah database dibuat di turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Vercel Blob — penyimpanan foto di produksi/Vercel (opsional; tanpa ini foto disimpan lokal)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
